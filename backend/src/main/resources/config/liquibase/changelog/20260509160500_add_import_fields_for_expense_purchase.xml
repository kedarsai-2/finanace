<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260509160500-1" author="cursor">
        <addColumn tableName="expense">
            <column name="received_paid_amount" type="numeric(21,2)"/>
            <column name="balance_due" type="numeric(21,2)"/>
            <column name="order_no" type="varchar(120)"/>
            <column name="item_name" type="varchar(200)"/>
            <column name="item_description" type="varchar(2000)"/>
            <column name="hsn_sac" type="varchar(64)"/>
            <column name="quantity" type="numeric(21,2)"/>
            <column name="unit_price" type="numeric(21,2)"/>
            <column name="discount_percent" type="numeric(21,2)"/>
            <column name="discount_amount" type="numeric(21,2)"/>
            <column name="tax_percent" type="numeric(21,2)"/>
            <column name="tax_amount" type="numeric(21,2)"/>
            <column name="line_amount" type="numeric(21,2)"/>
        </addColumn>
    </changeSet>

    <changeSet id="20260509160500-2" author="cursor">
        <addColumn tableName="purchase">
            <column name="order_no" type="varchar(120)"/>
            <column name="invoice_no" type="varchar(120)"/>
        </addColumn>
    </changeSet>

    <changeSet id="20260509160500-3" author="cursor">
        <addColumn tableName="purchase_line">
            <column name="hsn_sac" type="varchar(64)"/>
            <column name="category" type="varchar(120)"/>
            <column name="challan_order_no" type="varchar(120)"/>
            <column name="tax_amount" type="numeric(21,2)"/>
            <column name="transaction_type" type="varchar(40)"/>
            <column name="line_amount" type="numeric(21,2)"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
