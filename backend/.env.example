# Production secrets for finance-backend (copy to backend/.env — never commit .env).
# PM2 ecosystem.config.cjs loads this file automatically.

SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/finance_app
SPRING_DATASOURCE_USERNAME=finance_user
SPRING_DATASOURCE_PASSWORD=

# Required for prod profile. Keep stable across deploys or all users must re-login.
JHIPSTER_SECURITY_AUTHENTICATION_JWT_BASE64_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
